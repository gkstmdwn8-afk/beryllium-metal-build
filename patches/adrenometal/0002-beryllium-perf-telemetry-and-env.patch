+// beryllium (s34): NativeAdrenoMetal.env beside the bundle, KEY=VALUE lines ('#' starts a comment), goes into this process's environment before
+// Turnip and the runtime read theirs, so a switch (TU_DEBUG, TU_AUTOTUNE_ALGO, TU_CMD_CS_INITIAL_KB, NMB_PIPELINE_WAITS, ...) is tried on
+// the phone without a rebuild. Only the GPU stack's own prefixes are taken, and a variable already set is kept; the board's TU_DEBUG default
+// is set after this, so the file's TU_DEBUG wins. Returns how many lines were taken.
+static unsigned loadEnvironmentFile() {
+    char path[1024];
+    if (!requestedPath("NativeAdrenoMetal.env", path, sizeof path)) return 0;
+    FILE *file = fopen(path, "r");
+    if (!file) return 0;
+    static const char *const prefixes[] = {"TU_", "IR3_", "FD_", "MESA_", "VK_", "METAL2VULKAN_", "M2V_", "NMB_"};
+    unsigned taken = 0;
+    char line[512];
+    while (fgets(line, sizeof line, file)) {
+        line[strcspn(line, "\r\n")] = 0;
+        char *key = line;
+        while (*key == ' ' || *key == '\t') ++key;
+        char *equals = strchr(key, '=');
+        if (*key == '#' || !equals || equals == key) continue;
+        *equals = 0;
+        bool allowed = false;
+        for (const char *prefix : prefixes) allowed = allowed || !strncmp(key, prefix, strlen(prefix));
+        for (const char *c = key; allowed && *c; ++c) allowed = (*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') || *c == '_';
+        if (allowed && setenv(key, equals + 1, 0) == 0) ++taken;
+    }
+    fclose(file);
+    return taken;
+}
+static unsigned gEnvironmentTaken;
 // A listed process other than the render server: the same runtime on its own connection, with none of the render server's threads (no
 // display hand-off, telemetry, benchmark or cache export). Its shader cache lives in its own cache or temp directory.
 // The reason a client's device failed, as a text line the driver keeps per process (the render server's report row is rewritten every ten seconds):
@@ -210,6 +238,7 @@ static id deviceForPort(unsigned port) {
         if (tried) return device;
         tried = true;
         exceptiondiag::start(); // the throw site of an uncaught exception, for the kernel's THROW row (ExceptionDiag.h)
+        gEnvironmentTaken = loadEnvironmentFile();
         // The board selects Turnip's render-pass and concurrent-binning options.
         if (NATIVE_ADRENO_TURNIP_DEBUG[0]) {
             setenv("TU_DEBUG", NATIVE_ADRENO_TURNIP_DEBUG, 0);
@@ -222,6 +251,7 @@ static id deviceForPort(unsigned port) {
         Gpu *gpu = makeGpu(port);
         if (!gpu) return nil;
         gpu->mark(0x6800);
+        if (gEnvironmentTaken) gpu->mark(0x6840 | (gEnvironmentTaken > 0x3f ? 0x3f : gEnvironmentTaken));   // NativeAdrenoMetal.env lines taken
         char turnip[1024];
         if (!turnip::libraryPath(turnip, sizeof turnip) || access(turnip, R_OK) != 0) {gpu->mark(0x68f1); return nil;}
         gpu->mark(0x6801);
